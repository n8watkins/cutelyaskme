{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cutely Ask Me on Cloudflare Workers: the Next.js app built with OpenNext
  // (`npm run build:worker`), plus the notification queue consumer and the daily
  // reconciliation cron in worker/handlers.ts.
  "name": "cutelyaskme",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // nodejs_compat is required by @opennextjs/cloudflare, and web-push uses node:crypto and node:https.
  "compatibility_flags": ["nodejs_compat"],
  // No custom domain yet: the app is served at cutelyaskme.<account>.workers.dev
  // until the owner picks one (see README "Hosting").
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image resizes through the Cloudflare Images binding.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "queues": {
    // lib/notification-queue.ts wakes the notification outbox through this queue.
    "producers": [
      { "binding": "NOTIFICATION_QUEUE", "queue": "cutelyaskme-notification-delivery" }
    ],
    // worker/handlers.ts drains the outbox for each batch of wake-ups. A failed drain is
    // retried after 120 seconds (as on Vercel Queues); after 10 failed attempts the
    // message moves to the dead-letter queue. The outbox in the database keeps the
    // jobs themselves, so the daily cron still delivers them.
    "consumers": [
      {
        "queue": "cutelyaskme-notification-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 120,
        "dead_letter_queue": "cutelyaskme-notification-delivery-dlq"
      }
    ]
  },
  // Daily outbox reconciliation (was the Vercel cron for /api/notifications/process).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "EMAIL_FROM": "Date Night <onboarding@resend.dev>",
    "VAPID_SUBJECT": "mailto:nathancwatkins23@gmail.com"
  },
  // Every secret the Worker reads. Set each with `wrangler secret put <NAME>`,
  // never in this file. The first five are needed for the app to work; each
  // optional feature (email, AI notes, places, photos, push, static maps)
  // turns itself off while its secret is missing. CRON_SECRET also authorizes
  // the queue and cron calls in worker/handlers.ts.
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "CLERK_SECRET_KEY",
      "PLAN_CAPABILITY_SECRET",
      "CRON_SECRET",
      "NOTIFICATION_WORKER_SECRET",
      "RESEND_API_KEY",
      "GEMINI_API_KEY",
      "GOOGLE_PLACES_API_KEY",
      "CLOUDINARY_CLOUD_NAME",
      "CLOUDINARY_API_KEY",
      "CLOUDINARY_API_SECRET",
      "VAPID_PRIVATE_KEY",
      "STATIC_MAPS_SIGNING_SECRET",
      "STATIC_MAPS_EMAIL_KEY"
    ]
  }
  // NEXT_PUBLIC_* values are inlined by `next build`, so they belong in the build
  // environment (Workers Builds variables, or the shell for a manual deploy).
}
