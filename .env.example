# Turso - from turso.tech > your database > Connect
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required once when migrating existing plans. Map every plan id to its event timezone.
LEGACY_PLAN_TIMEZONES=

# Clerk - from clerk.com > your app > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Generate independent high-entropy values for these server-only secrets.
# PLAN_CAPABILITY_SECRET signs long-lived recipient access capabilities.
PLAN_CAPABILITY_SECRET=
# CRON_SECRET authenticates the daily notification outbox reconciliation job.
CRON_SECRET=
# Optional separate secret for manually triggering the notification worker.
NOTIFICATION_WORKER_SECRET=

# Clerk routes (keep these as-is)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Google Places API (New) - from console.cloud.google.com > APIs & Services
# Requires a billing account on file; set quota caps in the console so it
# can never charge. Free tier: Text Search 5,000/mo, Details 1,000/mo.
GOOGLE_PLACES_API_KEY=

# Resend - from resend.com > API Keys
RESEND_API_KEY=
EMAIL_FROM=Date Night <invites@cutelyask.me>

# Gemini - from aistudio.google.com > Get API Key
GEMINI_API_KEY=

# Cloudinary - from cloudinary.com > Dashboard (Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push - generate a VAPID key pair and keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@cutelyask.me

# This app's public URL (no trailing slash); use the production origin when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:1437

# Google Maps JavaScript API - browser key (separate from GOOGLE_PLACES_API_KEY).
# Restrict it in the console: API restriction "Maps JavaScript API" + website
# referrers (http://localhost:1437/*, your vercel.app URL). Free: 10k loads/mo.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Cloud-styled Map ID; DEMO_MAP_ID is used when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Use a server-restricted key and signing secret for email-safe static maps.
STATIC_MAPS_EMAIL_KEY=
STATIC_MAPS_SIGNING_SECRET=
