{
  "name": "cutelyaskme",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "@vercel/queue": {
      "minimatch": "11.0.4"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "scripts": {
    "dev": "next dev -p 1437",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts",
    "lint": "eslint",
    "db:migrate": "dotenv -e .env.local -- node scripts/migrate.mjs",
    "db:migrate:validate-copy": "node scripts/validate-migration-copy.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium webkit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "size": "node scripts/check-bundle-size.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.3",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@libsql/client": "^0.17.3",
    "@opennextjs/cloudflare": "1.20.15",
    "@vercel/queue": "^0.4.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "release-kit": "github:n8watkins/release-kit#v2.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "4.157.0"
  }
}
